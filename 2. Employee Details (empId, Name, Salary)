#include <iostream>
#include <string>
using namespace std;

class Employee {
public:
    int empId;
    string name;
    float salary;

    void accept() {
        cout << "Enter Employee ID: ";
        cin >> empId;
        cout << "Enter Name: ";
        cin >> name;
        cout << "Enter Salary: ";
        cin >> salary;
    }

    void display() {
        cout << "\nID: " << empId;
        cout << "\nName: " << name;
        cout << "\nSalary: " << salary << endl;
    }
};

int main() {
    Employee emp;
    emp.accept();
    emp.display();
    return 0;
}
